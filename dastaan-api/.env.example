# Copy to .env and fill in. NEVER commit .env.
PORT=4000
HOST=127.0.0.1
NODE_ENV=development

# 32+ char random secrets. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
CODE_PEPPER=

# Database — PostgreSQL.
# Leave DATABASE_URL empty for local dev: the API runs PGlite (real Postgres,
# embedded, persisted to ./data/pg) so no Docker or install is needed.
# Set it in production to your Supabase connection string:
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Comma-separated browser origins allowed to make state-changing requests
WEB_ORIGINS=http://localhost:3000

# Set to 1 when running behind a reverse proxy (correct client IPs for rate limiting)
TRUST_PROXY=0

# --- payments go/no-go (whole application) ---
# 0 = platform runs with NO card processing anywhere (pay at the desk).
# 1 = the separate payment service is live.
PAYMENTS_ENABLED=0
# which capture paths are on: online (Stripe Payment Intents), terminal (card readers)
PAYMENT_MODES=online,terminal
# the payment service is its own deployable — Stripe keys live THERE, not here
PAYMENT_SERVICE_URL=
PAYMENT_SERVICE_TOKEN=

# --- notifications (PRD 5.4) ---
# console = log only (dev). twilio = real SMS (fill the TWILIO_* vars).
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# links included in the post-service feedback message
REVIEW_URL=https://dastaan.example/review
GOOGLE_REVIEW_URL=https://g.page/r/dastaan/review
