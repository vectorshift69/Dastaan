# Copy to .env and fill in. NEVER commit .env.
PORT=4000
HOST=127.0.0.1
NODE_ENV=development

# 32+ char random secrets. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
CODE_PEPPER=

# Database — PostgreSQL.
# Leave DATABASE_URL empty for local dev: the API runs PGlite (real Postgres,
# embedded, persisted to ./data/pg) so no Docker or install is needed.
# Set it in production to your Supabase connection string:
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Comma-separated browser origins allowed to make state-changing requests
WEB_ORIGINS=http://localhost:3000

# Set to 1 when running behind a reverse proxy (correct client IPs for rate limiting)
TRUST_PROXY=0

# --- payments go/no-go (whole application) ---
# 0 = platform runs with NO card processing anywhere (pay at the desk).
# 1 = Stripe is live.
PAYMENTS_ENABLED=0
# which capture paths are on: online (Stripe Payment Intents), terminal (card readers)
PAYMENT_MODES=online,terminal

# The salon's Stripe account — money settles to them, not to us.
# Use the TEST keys (sk_test_…) until the salon signs off.
STRIPE_SECRET_KEY=sk_test_...
# From Stripe -> Developers -> Webhooks, after adding the endpoint.
# Without it card payments are refused.
STRIPE_WEBHOOK_SECRET=whsec_...

# --- how a booking may be paid ---
# The client chooses at booking: pay the whole amount now, or nothing now and
# settle after the visit (at the desk, or from their account in the app).
PAY_NOW_ENABLED=1
PAY_LATER_ENABLED=1        # set to 0 to insist on prepayment
REFUND_HOURS=24            # prepaid booking cancelled this far ahead is refunded

# --- notifications (PRD 5.4) ---
# console = log only (dev). twilio = real SMS (fill the TWILIO_* vars).
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# links included in the post-service feedback message
REVIEW_URL=https://dastaan.example/review
GOOGLE_REVIEW_URL=https://g.page/r/dastaan/review

# --- demo walkthrough ---
# The `demo` client's email. Set this to a real inbox you can open in front of
# the client so the password-reset link actually arrives. Left unset it stays
# on the reserved .test domain and cannot reach anyone.
DEMO_EMAIL=you@example.com

# --- password reset links ---
# APP_URL is the PUBLIC web address; reset emails point at it, so if this is
# wrong every link in every reset email is wrong.
APP_URL=http://localhost:3000
RESET_TTL_MINUTES=60
# Without EMAIL_PROVIDER the dev provider only PRINTS the link to the server
# log — reset emails will not actually arrive.
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# EMAIL_FROM="Dastaan <no-reply@yourdomain.ae>"
