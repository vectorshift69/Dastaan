# Copy to .env.local and fill in. NEVER commit .env.local.

# Where the dastaan-api service is reachable — /api/* is proxied server-side
# to this address, so the browser stays same-origin.
API_URL=http://localhost:4000

# Stripe's PUBLISHABLE key (pk_test_... / pk_live_...) — safe to expose to the
# browser, unlike the secret key, which lives only in dastaan-api. Required
# for the booking wizard's payment step and the store's Stripe checkout;
# without it, both fall back to "pay at the salon" / "pay on delivery".
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Supabase — used for file uploads (training videos, staff photos).
# Both values are safe to expose to the browser. The anon key only has
# access to what your Row Level Security policies allow; keep uploads-only
# RLS so nothing else is readable via this key.
# Find these in: Supabase dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
