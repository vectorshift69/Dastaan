# The salon's Stripe account — money settles to them, not to us.
# Use the TEST keys (sk_test_…) until the salon signs off.
STRIPE_SECRET_KEY=sk_test_...
# From Stripe -> Developers -> Webhooks, after adding the endpoint.
# Without it this service refuses every webhook.
STRIPE_WEBHOOK_SECRET=whsec_...

# Must match PAYMENT_SERVICE_TOKEN in dastaan-api. Nothing else may call us.
PAYMENT_SERVICE_TOKEN=<48 random bytes hex>

# Same database as the main API — one salon, one set of books.
DATABASE_URL=postgresql://...

CURRENCY=aed
PORT=4100

# --- how a booking may be paid ---
# The client chooses at booking: pay the whole amount now, or nothing now and
# settle after the visit (at the desk, or from their account in the app).
PAY_NOW_ENABLED=1
PAY_LATER_ENABLED=1        # set to 0 to insist on prepayment
REFUND_HOURS=24            # prepaid booking cancelled this far ahead is refunded
